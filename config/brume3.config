# ============================================================================
#  GL.iNet GL-MT5000 (Brume 3) – полный конфиг для сборки
#  База: GL.iNet mt5000 (ядро 6.18) или ImmortalWrt 25.12+
#  Место не экономим, ставим всё нужное.
# ============================================================================

# ---- Целевое устройство (не трогать) ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- Пакетный менеджер (для 25.12+ это apk) ----
CONFIG_USE_APK=y

# ---- Ускорение сборки ----
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---- Базовый веб-интерфейс ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# ---- Тема и её настройка ----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---- Базовая сеть и DHCP ----
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ---- Пакетный менеджер (apk) ----
CONFIG_PACKAGE_apk-mbedtls=y

# ---- VPN и прокси (основное) ----
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y

# ---- sing-box extended (для XHTTP и новых протоколов) ----
CONFIG_PACKAGE_sing-box-extended=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-homeproxy=y

# ---- DNS и блокировка рекламы ----
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-adblock-fast=y

# ---- Ускорение сети ----
CONFIG_PACKAGE_luci-app-turboacc=y

# ---- WireGuard / удалённый доступ ----
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y

# ---- DynDNS ----
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# ---- SQM / борьба с буферблатом ----
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-sched-cake=y

# ---- Мониторинг трафика ----
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-bandix-plus=y

# ---- Терминал и системные утилиты ----
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_luci-app-filemanager=y

# ---- Диски и хранилище ----
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_ntfs_3g_utils=y
CONFIG_PACKAGE_luci-app-partexp=y

# ---- UPnP / проброс портов ----
CONFIG_PACKAGE_luci-app-upnp=y

# ---- Wake-on-LAN ----
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-timewol=y

# ---- KMS-сервер ----
CONFIG_PACKAGE_luci-app-vlmcsd=y

# ---- Уведомления ----
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y

# ---- Просмотр онлайн-клиентов ----
CONFIG_PACKAGE_luci-app-onliner=y

# ---- MQTT-клиент (для Home Assistant) ----
CONFIG_PACKAGE_mosquitto-client-nossl=y

# ---- Статистика и мониторинг ----
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd-mod-ping=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# ---- Управление системой ----
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-store=y

# ---- Доступ для Home Assistant ----
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y

# ---- Модули ядра (критично для прокси) ----
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ---- Слой совместимости (для старых скриптов) ----
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ipset=y
